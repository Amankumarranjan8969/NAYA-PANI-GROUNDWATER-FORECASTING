# ===============================================================================
# NAYA PANI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# Note: '.env' is excluded by .gitignore and should never be committed to Git.
# ===============================================================================

# 1. Admin Master Account (Required only for the protected /?page=admin dashboard)
ADMIN_MASTER_ID=admin@nayapani.org
ADMIN_MASTER_PASSWORD=YourSecureMasterPassword123!

# Optional: set a pre-hashed argon2 password instead of plaintext
# ADMIN_MASTER_PASSWORD_HASH=argon2$<hash>

# 2. Optional AI LLM Provider Keys for RAG Assistant
# (Naya Pani functions 100% offline using local synthesized context if unset)
# GEMINI_API_KEY=your_google_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here

# 3. Microservice Networking Defaults
FASTAPI_PORT=8080
STREAMLIT_PORT=8501
FASTAPI_HOST=127.0.0.1
