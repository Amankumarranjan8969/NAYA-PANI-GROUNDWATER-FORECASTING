[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "your-provider-client-id"
client_secret = "your-provider-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[access]
admin_emails = ["admin@nayapani.org"]
user_emails = ["analyst@example.com"]

[admin]
master_id = "admin@nayapani.org"
master_password = "YourSecureMasterPassword123!"
GEMINI_API_KEY = "your-gemini-api-key-here"
ANTHROPIC_API_KEY = "your-anthropic-api-key-here"
